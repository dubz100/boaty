# Boaty Mk1 helm parameters: SpeedyBee F405 WING APP board wiring.
#
# Hardware only; never loaded in simulation. From BOATY-KCL-001 section 7 and
# ArduPilot's SpeedyBeeF405WING board definition (docs/kcl/sources/).

SERIAL1_PROTOCOL    2       # MAVLink 2 to the Pi Zero (IF-04)
SERIAL1_BAUD        115
SERIAL2_PROTOCOL    -1      # unused (SBUS inverter on RX)
SERIAL3_PROTOCOL    5       # GPS (IF-22)
SERIAL6_PROTOCOL    -1      # wireless board not fitted (KCL KF-04)

MOT_PWM_TYPE        6       # DShot300 (IF-05)
SERVO_DSHOT_ESC     1       # AM32
SERVO_BLH_3DMASK    9       # outputs 1 and 4 reversible

BATT_VOLT_PIN       10
BATT_CURR_PIN       11
BATT_VOLT_MULT      11.05   # calibrate on the bench (KF-10)
BATT_AMP_PERVLT     50      # calibrate on the bench (KF-10)
BATT2_VOLT_MULT     11.0    # 10k / 1k divider (IF-06)

LOG_BACKEND_TYPE    1       # microSD
NTF_LED_TYPES       257     # board LEDs + NeoPixel
SERVO12_FUNCTION    120     # NeoPixel1 on the LED pad (IF-09)
GPS_TYPE            1       # auto
COMPASS_EXTERNAL    1
